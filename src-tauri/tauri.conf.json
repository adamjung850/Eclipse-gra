{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delveria",
  "version": "0.1.0",
  "identifier": "com.delveria.game",
  "build": {
    "beforeDevCommand": "npm run build && node scripts/prepare-dist.mjs",
    "beforeBuildCommand": "npm run build && node scripts/prepare-dist.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Delveria",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
