{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./js",
    "rootDir": "./src",
    "sourceMap": false,
    "declaration": false,
    "types": ["phaser"]
  },
  "include": ["src/**/*", "node_modules/phaser/types/phaser.d.ts"]
}
