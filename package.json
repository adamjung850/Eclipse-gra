{
  "name": "eclipse-the-lost-world",
  "version": "0.1.0",
  "description": "2D Sandbox RPG Game inspired by Terraria, Starbound and Core Keeper",
  "type": "module",
  "scripts": {
    "dev": "python -m http.server 8080",
